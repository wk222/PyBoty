# PyBoty Environment Configuration

# API Keys for the Gateway Guard
# Format: key1:scope1,scope2;key2:scope1
# Use '*' for all scopes.
# If not set, defaults to 'dev-key:*'
PYBOT_API_KEYS="your-secret-key-here:*"

# CORS Origins (comma separated)
# PYBOT_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# OpenAI API Key (or other provider keys)
# OPENAI_API_KEY="sk-..."
